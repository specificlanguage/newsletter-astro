---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from "../../components/FormattedDate.astro";
import {getNewsletterCollection, readingTime, stripHTML} from "../../lib/frontPageHelpers";
import type {GetStaticPaths} from "astro";
import FrontPageCard from "../../components/FrontPageCard.astro";

export const getStaticPaths = (async ({ paginate }) => {
    const newsletterPages = await getNewsletterCollection();
    newsletterPages.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return paginate(newsletterPages, { pageSize: 5 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

if(page.currentPage == 0){
    return Astro.redirect("/")
}

---

<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
<Header title={SITE_TITLE} />
<main>
    {page.data.map((entry) => (
        <FrontPageCard entry={entry} />
    ))}
    <div class="grid grid-cols-3 justify-items-center paginate">
        <div>
            {(page.currentPage == 2) && <a href="/">Newer</a>}
            {(page.currentPage - 1 <= page.lastPage && page.currentPage > 2) &&
                    <a class="p-3 border border-neutral-200  hover:bg-neutral-500 hover:text-white" href={"/page/" + (page.currentPage - 1).toString()}>Newer</a>
            }
        </div>
        <div>
            Page {page.currentPage} / {page.lastPage}
        </div>
        <div>
            {page.currentPage + 1 <= page.lastPage &&
                    <a class="p-3 border border-neutral-200  hover:bg-neutral-500 hover:text-white" href={"/page/" + (page.currentPage + 1).toString()}>Older</a>
            }
        </div>
    </div>
</main>
<Footer />
</body>
</html>